{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check --frozen scripts/*.ts tests/*.ts benchmarks/*.ts",
    "test": "deno run --frozen -A scripts/test-ci.ts",
    "test:unit": "deno test --frozen -A tests/*_test.ts"
  },
  "fmt": {
    "include": [
      "deno.json",
      "scripts/**/*.ts",
      "tests/**/*.ts",
      "benchmarks/**/*.ts"
    ]
  },
  "lint": {
    "include": ["scripts/**/*.ts", "tests/**/*.ts", "benchmarks/**/*.ts"]
  },
  "test": { "include": ["tests/*_test.ts"] },
  "nodeModulesDir": "none",
  "imports": {
    "@msgpack/msgpack": "npm:@msgpack/msgpack@3.1.3",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/path": "jsr:@std/path@1.1.6"
  }
}
